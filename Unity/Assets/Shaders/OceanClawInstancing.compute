// HokusaiClawInstanced.shader に渡すインスタンスごとのデータ。
// 爪状白波の描画に必要な値を保持する。
struct ClawInstanceData
{
    float4 row0;
    float4 row1;
    float4 row2;
    float4 row3;
    float4 params; // x = 波頭の評価値、y = 生存値、z = 0～1 の乱数、w = 展開量
};

// 決定的な並べ替えと揺らぎを加えた、一つの走査格子セル。
// 同じ入力なら同じ走査位置を再現できる。
struct ScanCell
{
    uint index;
    uint2 id;
    uint seed;
    float random01;
    float2 worldXZ;
};

// 一つの波頭の簇に含まれる爪状白波の配置データ。
// 簇内の各要素の位置と向きに使う。
struct ClusterPlacement
{
    uint seed;
    float lateralOffset;
    float forwardOffset;
    float growthDelay;
};

Texture2D<float4> _ClawMaskTexture;
Texture2DArray<float4> _DisplacementTexture;
Texture2DArray<float2> _SlopeTexture;

RWStructuredBuffer<ClawInstanceData> _ClawInstances;
RWStructuredBuffer<uint> _ClawCounter;
RWStructuredBuffer<uint> _ArgsBuffer;
RWStructuredBuffer<uint> _UnderlayArgsBuffer;
// 走査セルごとに float4 を二つ使用する。
// スロット 0（cell*2）：x は生存値、y は乱数、z は平滑化した評価値、w は初期化フラグ。
// スロット 1（cell*2+1）：xy は波とともに移動する、波頭へ固定した基点の世界 XZ 座標。
// 各走査セルの生存状態と基点を別々に保持する。
// スロット 0 は生存値、乱数、平滑化した評価値、初期化フラグを持つ。
// スロット 1 は波頭に追従する基点の世界 XZ 座標を持つ。
RWStructuredBuffer<float4> _ClawCellState;

