// Per-instance data consumed by HokusaiClawInstanced.shader.
// 每个爪形实例传给 HokusaiClawInstanced.shader 的数据。
struct ClawInstanceData
{
    float4 row0;
    float4 row1;
    float4 row2;
    float4 row3;
    float4 params; // x = crest score, y = life, z = random01, w = growthOpen
};

// One scan-grid cell after deterministic shuffling and jitter.
// 经过确定性打散和随机偏移后的一个扫描格子。
struct ScanCell
{
    uint index;
    uint2 id;
    uint seed;
    float random01;
    float2 worldXZ;
};

// Per-claw placement data inside one crest cluster.
// 单个波峰簇内部一个爪形的摆放数据。
struct ClusterPlacement
{
    uint seed;
    float lateralOffset;
    float forwardOffset;
    float growthDelay;
};

Texture2D<float4> _ClawMaskTexture;
Texture2DArray<float4> _DisplacementTexture;
Texture2DArray<float2> _SlopeTexture;

RWStructuredBuffer<ClawInstanceData> _ClawInstances;
RWStructuredBuffer<uint> _ClawCounter;
RWStructuredBuffer<uint> _ArgsBuffer;
RWStructuredBuffer<uint> _UnderlayArgsBuffer;
// Two float4 slots per scan cell:
//   slot 0 (cell*2)   : x = life, y = random, z = smoothed score, w = initialized
//   slot 1 (cell*2+1) : xy = crest-locked anchor (world XZ) that drifts with the wave
// 每个扫描格占两个 float4：
//   槽 0：生命值 / 随机数 / 平滑评分 / 初始化标记
//   槽 1：xy = 锁定波峰的世界 XZ 锚点（随波漂移，是爪形平滑跟随的关键）
RWStructuredBuffer<float4> _ClawCellState;

